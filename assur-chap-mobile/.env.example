# ==========================================================================
# Assur Chap Mobile — variables d'environnement Expo
# Sans ces variables, l'app tourne en MODE DÉMO (données en mémoire).
# Les variables EXPO_PUBLIC_* sont exposées au bundle client.
# ==========================================================================
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optionnel (défaut : <SUPABASE_URL>/functions/v1)
EXPO_PUBLIC_FUNCTIONS_URL=
