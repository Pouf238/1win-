# ==========================================================================
# Assur Chap — variables d'environnement (Next.js)
# ==========================================================================
# Sans NEXT_PUBLIC_SUPABASE_URL + ANON_KEY, l'app tourne en MODE DÉMO (local).
# Dès que ces deux variables sont définies, Supabase devient la source unique
# de vérité (auth, données, edge functions).
# Côté front, seules les variables NEXT_PUBLIC_* sont exposées au navigateur.
# ==========================================================================

# --- Supabase : OBLIGATOIRE pour le mode production ---
# Dashboard Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL des Edge Functions (défaut : <SUPABASE_URL>/functions/v1)
NEXT_PUBLIC_FUNCTIONS_URL=
# URL publique de l'app (liens de vérification / retour paiement)
NEXT_PUBLIC_APP_URL=

# Mode démo / repli local : mettre "false" en production pour masquer le bouton
# « compte démo » (le repli local reste utilisé si Supabase n'est pas configuré).
NEXT_PUBLIC_ALLOW_DEMO=

# --- Secrets serveur (Edge Functions Supabase / scripts admin — JAMAIS exposés au front) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Paiements (configurés comme secrets des Edge Functions Supabase) ---
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=

# --- IA (assistant, OCR, détection de fraude) ---
OPENAI_API_KEY=

# --- WhatsApp Business API ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# --- Emails (Resend) ---
RESEND_API_KEY=
RESEND_FROM="Assur Chap <contrats@assurchap.com>"

# --- Cartographie ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
