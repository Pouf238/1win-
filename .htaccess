# Symo Print — plateforme d'impression en ligne
Options -Indexes -MultiViews
DirectoryIndex index.php
ServerSignature Off

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]
# Code, docs, outils, tests, dépôt et fichiers cachés : jamais accessibles
RewriteRule ^(_app|tools|docs|tests|\.git|\.github|\.hostinger)(/|$) - [F,L]
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|CNAME|.*\.(sql|md|log|sh|py|env|bak|sqlite|inc|ini|yml|yaml|lock))$ - [F,L]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
RewriteRule ^ index.php [L,QSA]
</IfModule>

# Les pages dynamiques (PHP) envoient elles-mêmes leurs en-têtes de sécurité (CSP, HSTS…).
# Ici : uniquement les fichiers statiques servis directement par le serveur web.
<IfModule mod_headers.c>
Header always unset X-Powered-By
Header unset X-Powered-By
<FilesMatch "\.(woff2?|css|js|svg|png|webp|jpe?g|gif|ico|txt|xml)$">
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Strict-Transport-Security "max-age=31536000"
Header always set Cross-Origin-Resource-Policy "same-origin"
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "\.svg$">
Header always set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
php_flag display_errors off
